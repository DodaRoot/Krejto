spring.application.name=server
spring.datasource.url=jdbc:postgresql://localhost:5000/krejto_db
spring.datasource.username=krejto_user
spring.datasource.password=krejto_password

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
spring.flyway.baseline-description=init

// Example jwt secrets
jwt.secret=N+7qdAR2pXfVStBK+51p30Y8l/c5mVrvf/ub3PdKqoQ=\n
jwt.expiration=1800000